{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "popperpad/certificate/truth/v1",
  "type": "object",
  "required": [
    "schema",
    "certificate_id",
    "certificate_kind",
    "claim_ref",
    "verifier_ref",
    "evidence_refs",
    "verifier_result",
    "truth_boundary"
  ],
  "properties": {
    "schema": { "const": "popperpad/certificate/truth/v1" },
    "certificate_id": { "type": "string", "minLength": 1 },
    "certificate_kind": {
      "enum": [
        "proof",
        "refutation",
        "reproduction",
        "boundary",
        "formalization",
        "verifier_improvement"
      ]
    },
    "claim_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "context_ref": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "verifier_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "recipe_ref": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "verifier_result": {
      "type": "object",
      "required": ["accepted", "status"],
      "properties": {
        "accepted": { "const": true },
        "status": {
          "enum": [
            "supported",
            "refuted",
            "reproduced",
            "narrowed",
            "formalized",
            "maintained"
          ]
        }
      },
      "additionalProperties": true
    },
    "signatures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "truth_boundary": { "const": "verifier_checked_certificate" }
  },
  "additionalProperties": true
}
