{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "popperpad/hypothesis/v1",
  "type": "object",
  "required": ["schema", "hypothesis_id", "title", "statement", "check_recipe_refs"],
  "properties": {
    "schema": { "const": "popperpad/hypothesis/v1" },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "statement": {
      "type": "object",
      "required": ["lang", "body"],
      "properties": {
        "lang": { "type": "string" },
        "body": { "type": "string" }
      },
      "additionalProperties": true
    },
    "domain_ref": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "context_ref": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "check_recipe_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    }
  },
  "additionalProperties": true
}

