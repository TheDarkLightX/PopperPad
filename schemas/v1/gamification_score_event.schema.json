{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "popperpad/gamification/score-event/v1",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "agent_ref",
    "event_kind",
    "point_kind",
    "point_delta",
    "subject_ref",
    "evidence_refs",
    "truth_boundary"
  ],
  "properties": {
    "schema": { "const": "popperpad/gamification/score-event/v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "agent_ref": { "type": "string", "minLength": 1 },
    "event_kind": {
      "enum": [
        "proof_accepted",
        "counterexample_verified",
        "reproduction_completed",
        "boundary_found",
        "recipe_maintained",
        "artifact_preserved",
        "curation_used",
        "quest_completed"
      ]
    },
    "point_kind": {
      "enum": ["xp", "reputation", "season_score", "badge", "streak"]
    },
    "point_delta": { "type": "integer" },
    "subject_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "domain_ref": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "token_reward": { "type": ["string", "null"] },
    "anti_abuse": {
      "type": "object",
      "properties": {
        "verifier_required": { "type": "boolean" },
        "sybil_risk": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "truth_boundary": { "const": "gamification_only" }
  },
  "additionalProperties": true
}
